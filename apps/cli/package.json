{
  "name": "@zamu/cli",
  "version": "0.0.0",
  "description": "zamu: command-line client for Zamu",
  "license": "MIT",
  "type": "module",
  "bin": {
    "zamu": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsdown",
    "package:npm": "node scripts/npm-package.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p scripts",
    "test": "vitest run"
  },
  "dependencies": {
    "@orpc/client": "1.16.0",
    "@orpc/contract": "1.16.0",
    "@orpc/openapi-client": "1.16.0",
    "commander": "15.0.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@zamu/contracts": "workspace:*",
    "tsdown": "0.23.1"
  }
}
